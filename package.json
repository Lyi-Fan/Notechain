{
  "name": "notechain",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test tests/*.test.ts && node --test tests/cli-integration.test.mjs tests/extension.test.mjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:native": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:cli": "node --test tests/cli-integration.test.mjs",
    "test:extension": "node --test tests/extension.test.mjs",
    "test:runtime": "node scripts/runtime-check.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "mac:native": "node scripts/mac-native.mjs",
    "mac:dev": "npm run mac:native && tauri dev",
    "mac:build": "npm run mac:native && tauri build --bundles app",
    "mac:qa": "npm run mac:native && tauri build --bundles app --features qa",
    "windows:dev": "tauri dev",
    "windows:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-build.ps1",
    "windows:qa": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows-build.ps1 -Qa"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "linkifyjs": "4.3.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "marked": "17.0.6",
    "misans": "^4.1.0",
    "pathfinding": "^0.4.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "@types/pathfinding": "^0.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
