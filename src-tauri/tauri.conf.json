{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notechain",
  "mainBinaryName": "Notechain",
  "version": "1.1.3",
  "identifier": "io.github.lyi-fan.notechain",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' ledger-image: blob: data: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [{"ext": ["md", "markdown"], "name": "Markdown Document", "role": "Editor"}],
    "active": true,
    "targets": ["app"],
    "resources": {"bin/ledger-pdf":"bin/ledger-pdf","bin/ledger-atoll":"bin/ledger-atoll","licenses/":"licenses/","../extension/":"extension/","../skills/notechain-graph/":"skills/notechain-graph/"},
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
